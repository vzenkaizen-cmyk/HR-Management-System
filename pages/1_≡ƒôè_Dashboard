import streamlit as st
import plotly.graph_objects as go
import plotly.express as px
import pandas as pd

from auth.auth import require_login
from utils.styles import inject_css, kpi_card, section_header, ACCENTS
from utils.helpers import load_records, apply_filters

st.set_page_config(page_title="Dashboard", page_icon="📊", layout="wide")
inject_css()
require_login()

st.markdown('<div class="app-title">Training Dashboard</div>', unsafe_allow_html=True)
st.write("")

df_all = load_records()

if df_all.empty:
    st.info("No training records yet. Add some from the **Data Entry** page to see the dashboard.")
    st.stop()

# ---------- Filter bar ----------
st.markdown('<div class="filter-bar">', unsafe_allow_html=True)
f1, f2, f3, f4, f5 = st.columns([1.2, 1, 1, 1, 0.7])
with f1:
    st.markdown('<div class="filter-label">LOCATION</div>', unsafe_allow_html=True)
    location = st.selectbox(
        "Location", ["All Locations"] + sorted(df_all["location"].dropna().unique().tolist()),
        label_visibility="collapsed",
    )
with f2:
    st.markdown('<div class="filter-label">YEAR</div>', unsafe_allow_html=True)
    year = st.selectbox(
        "Year", ["All Years"] + sorted(df_all["year"].dropna().unique().astype(int).tolist(), reverse=True),
        label_visibility="collapsed",
    )
with f3:
    st.markdown('<div class="filter-label">MONTH</div>', unsafe_allow_html=True)
    month_order = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"]
    months_present = [m for m in month_order if m in df_all["month"].unique()]
    month = st.selectbox("Month", ["All Months"] + months_present, label_visibility="collapsed")
with f4:
    st.markdown('<div class="filter-label">TYPE</div>', unsafe_allow_html=True)
    ttype = st.selectbox("Type", ["All Types"] + sorted(df_all["training_type"].dropna().unique().tolist()),
                         label_visibility="collapsed")
with f5:
    st.write("")
    st.write("")
    if st.button("Reset filters", use_container_width=True):
        st.rerun()
st.markdown("</div>", unsafe_allow_html=True)

df = apply_filters(df_all, location, year, month, ttype)

if df.empty:
    st.warning("No records match the selected filters.")
    st.stop()

# ---------- KPI cards ----------
total_hours = df["total_hours"].sum()
n_programmes = df["id"].nunique()
participants = df["participants_count"].sum()
avg_hours_prog = df["training_hours"].mean()
total_cost = df["training_cost"].sum()
avg_cost_prog = df["training_cost"].mean()
avg_cost_person = (df["training_cost"].sum() / df["participants_count"].sum()) if df["participants_count"].sum() else 0

kpis = [
    ("TOTAL TRAINING HOURS", f"{total_hours:,.0f}", "across selected period"),
    ("NO. OF PROGRAMMES", f"{n_programmes:,}", "training sessions run"),
    ("PARTICIPANTS ATTENDED", f"{participants:,.0f}", "total attendance count"),
    ("AVG. HOURS / PROGRAMME", f"{avg_hours_prog:,.1f}", "training hours per session"),
    ("TOTAL TRAINING COST", f"Rs. {total_cost:,.0f}", "Rs., across selected period"),
    ("AVG. COST / PROGRAMME", f"Rs. {avg_cost_prog:,.0f}", "Rs. per session"),
    ("AVG. COST / PERSON", f"Rs. {avg_cost_person:,.0f}", "Rs. per participant"),
]
cols = st.columns(7)
for col, (label, value, sub), accent in zip(cols, kpis, ACCENTS):
    with col:
        kpi_card(label, value, sub, accent)

st.write("")
st.write("")

# ---------- Charts ----------
c1, c2 = st.columns([1.4, 1])

with c1:
    section_header(
        "Trend — Training Hours & Programme Count",
        "Bars = training hours (left axis) · Line = number of programmes (right axis)",
    )
    trend = (
        df.groupby(pd.PeriodIndex(df["from_date"], freq="M"))
        .agg(hours=("total_hours", "sum"), programmes=("id", "nunique"))
        .reset_index()
    )
    trend["period_str"] = trend["from_date"].astype(str)

    fig = go.Figure()
    fig.add_bar(x=trend["period_str"], y=trend["hours"], name="Training Hours", marker_color="#22d3c3")
    fig.add_trace(
        go.Scatter(
            x=trend["period_str"], y=trend["programmes"], name="Programmes",
            yaxis="y2", mode="lines+markers", line=dict(color="#f0b429", width=3),
        )
    )
    fig.update_layout(
        template="plotly_dark",
        plot_bgcolor="rgba(0,0,0,0)",
        paper_bgcolor="rgba(0,0,0,0)",
        yaxis=dict(title="Training Hours"),
        yaxis2=dict(title="Programmes", overlaying="y", side="right", showgrid=False),
        legend=dict(orientation="h", y=1.15),
        margin=dict(l=10, r=10, t=10, b=10),
        height=380,
    )
    st.plotly_chart(fig, use_container_width=True)

with c2:
    section_header("Technical vs Soft Skill", "Share of training hours by programme type")
    type_share = df.groupby("training_type")["total_hours"].sum().reset_index()
    fig2 = px.pie(
        type_share, names="training_type", values="total_hours", hole=0.55,
        color_discrete_sequence=["#22d3c3", "#f0b429"],
    )
    fig2.update_layout(
        template="plotly_dark",
        plot_bgcolor="rgba(0,0,0,0)",
        paper_bgcolor="rgba(0,0,0,0)",
        margin=dict(l=10, r=10, t=10, b=10),
        height=380,
        legend=dict(orientation="h", y=-0.1),
    )
    st.plotly_chart(fig2, use_container_width=True)

st.write("")
c3, c4 = st.columns(2)
with c3:
    section_header("Training Cost by Location")
    cost_loc = df.groupby("location")["training_cost"].sum().sort_values(ascending=True).reset_index()
    fig3 = px.bar(cost_loc, x="training_cost", y="location", orientation="h",
                  color_discrete_sequence=["#4d8dfc"])
    fig3.update_layout(template="plotly_dark", plot_bgcolor="rgba(0,0,0,0)",
                        paper_bgcolor="rgba(0,0,0,0)", height=320,
                        margin=dict(l=10, r=10, t=10, b=10), xaxis_title="Rs.", yaxis_title="")
    st.plotly_chart(fig3, use_container_width=True)

with c4:
    section_header("Top Programmes by Total Hours")
    top_prog = df.groupby("programme_name")["total_hours"].sum().sort_values(ascending=False).head(8).reset_index()
    fig4 = px.bar(top_prog.sort_values("total_hours"), x="total_hours", y="programme_name", orientation="h",
                  color_discrete_sequence=["#7c6ef2"])
    fig4.update_layout(template="plotly_dark", plot_bgcolor="rgba(0,0,0,0)",
                        paper_bgcolor="rgba(0,0,0,0)", height=320,
                        margin=dict(l=10, r=10, t=10, b=10), xaxis_title="Hours", yaxis_title="")
    st.plotly_chart(fig4, use_container_width=True)
