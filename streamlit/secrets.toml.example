# Copy this file to .streamlit/secrets.toml for LOCAL development.
# NEVER commit the real secrets.toml to GitHub (it is already in .gitignore).
# On Streamlit Community Cloud, paste the same content into:
#   App settings -> Secrets

[postgres]
# Get this connection string from your Neon project dashboard
# (Connect -> copy the "psql" / pooled connection string).
# It must include ?sslmode=require for Neon.
url = "postgresql://<user>:<password>@<neon-host>/<db>?sslmode=require"

[app]
# Used to seed the very first admin account on first run.
# Change these, then remove/blank them out after you've logged in once.
first_admin_username = "admin"
first_admin_email = "admin@vidullanka.com"
first_admin_password = "ChangeMe123!"
first_admin_fullname = "System Administrator"
